# Backend configuration
# Copy this file to `.env` (cp .env.example .env) before running the API or
# `docker compose up` — docker-compose reads this same file (see ../docker-compose.yml).

# Port the REST API listens on (Railway injects PORT automatically).
PORT=3020

# Allowed CORS origin(s) — comma-separated. The Vite dev server runs on 3021.
CORS_ORIGIN=http://localhost:3021

# --- Access control ---
# HTTP Basic credentials required for every API call (the tablet stores them
# after the first login). Use a long random password in production.
BASIC_AUTH_USER=admin
BASIC_AUTH_PASSWORD=change-me

# Initial 4-digit PINs, copied into the database on first boot. Change them later from
# the admin page; after that these env values are ignored.
# SETTINGS_PIN unlocks the per-device settings page (assign room, kiosk mode).
# ADMIN_PIN unlocks the admin page (rooms, calendar, security) and all admin API calls.
SETTINGS_PIN=1234
ADMIN_PIN=0000

# How often the tablets ask the API for fresh room status, in seconds. Every
# such request re-reads the room's calendar, so this is also how often events
# are fetched from Google. Only applied when the settings row is first created;
# change it later from the admin page. Allowed range: 5-300.
POLL_INTERVAL_SECONDS=60

# IANA timezone used for "today", day boundaries and displayed times.
TIMEZONE=Europe/Warsaw

# How often the backend re-reads the calendar of a room that has a tablet
# connected, in seconds. This is the delay before an event you add in Google
# Calendar appears on the screen (pushed over SSE). Range 2-300.
WATCH_INTERVAL_SECONDS=5

# --- Calendar provider ---
# local  -> events live in the local database (no Google account needed; great for dev/testing, seed creates some)
# google -> events are read from / written to Google Calendar via a service account
CALENDAR_PROVIDER=local

# Google service account (only needed when CALENDAR_PROVIDER=google).
# Create a service account in Google Cloud, enable the Calendar API, then EITHER
# share each room calendar with the service-account e-mail ("Make changes to events")
# OR enable domain-wide delegation and set GOOGLE_IMPERSONATE_USER to a Workspace user
# who can manage the room calendars.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private key from the JSON key file. Keep the literal "\n" sequences -
# they are converted to real newlines at runtime.
GOOGLE_PRIVATE_KEY=
GOOGLE_IMPERSONATE_USER=

# --- Seed data (pnpm seed) ---
# Rooms created by the seed command: Name=calendarId pairs separated by commas.
# With CALENDAR_PROVIDER=local the calendarId can be any unique string.
SEED_ROOMS=Yellow=yellow@local,Violet=violet@local,Palmiarnia=palmiarnia@local

# --- Database ---
# Credentials for the docker-compose PostgreSQL container (see ../docker-compose.yml).
# These must match DATABASE_URL below.
POSTGRES_USER=roombooking
POSTGRES_PASSWORD=roombooking_secret
POSTGRES_DB=roombooking

# Host port the database is exposed on (container always listens on 5432).
# Keep this in sync with the port in DATABASE_URL.
POSTGRES_PORT=5434

# Full Postgres connection string - the only DB variable the app itself reads.
# On Railway, reference the Postgres plugin: ${{Postgres.DATABASE_URL}}
# Append ?sslmode=require if your provider requires SSL.
DATABASE_URL=postgres://roombooking:roombooking_secret@localhost:5434/roombooking
