# Base URL of the backend REST API, including the /api prefix.
# Leave empty to use the relative `/api` path (the Vite dev server proxies it to
# http://localhost:3020, and in production you can put the API behind the same host).
# On Railway set it to the public backend URL, e.g. https://room-booking-api.up.railway.app/api
VITE_API_URL=
